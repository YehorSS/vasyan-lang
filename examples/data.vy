-- data.vy — списки, словники, цикл кожен, вбудовані функції

--[ Блоковий коментар:
    цей файл показує нові можливості мови.
]--

-- Списки
хай числа = [5, 3, 8, 1]
додати(числа, 10)
кажи числа                 -- [5, 3, 8, 1, 10]
кажи довжина(числа)        -- 5

-- Сума через цикл по діапазону (кінець не включається)
хай сума = 0
кожен i у 0..довжина(числа)
    сума += числа[i]
кінець
кажи сума                  -- 27

-- Пошук максимуму
фікс перший = числа[0]
хай макс = перший
кожен i у 1..довжина(числа)
    якшо числа[i] > макс
        макс = числа[i]
    кінець
кінець
кажи макс                  -- 10

-- Словники
хай гаманець = {"грн": 1500, "usd": 40}
гаманець["eur"] = 25
кажи гаманець["грн"]       -- 1500
кажи є_ключ(гаманець, "btc")   -- неа
кажи довжина(гаманець)     -- 3

-- Рядки і перетворення
хай імя = "Вася"
кажи довжина(імя)          -- 4
кажи імя[0]                -- В
кажи число("42") + 8       -- 50
кажи корінь(144)           -- 12
