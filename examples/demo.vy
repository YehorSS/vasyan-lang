-- demo.vy — демонстрація синтаксису VasyanLang
-- без {}, без ;, блоки закриваються словом `кінець`

го факторіал(н)
    якшо н <= 1
        верни 1
    кінець
    верни н * факторіал(н - 1)
кінець

-- сума 1..н циклом
го сума_до(н)
    хай підсумок = 0
    хай і = 1
    поки і <= н
        підсумок = підсумок + і
        і = і + 1
    кінець
    верни підсумок
кінець

кажи факторіал(5)      -- 120
кажи сума_до(100)      -- 5050

хай прапор = ага і неа
якшо не прапор
    кажи "логіка працює"
інакше
    кажи "щось не так"
кінець
